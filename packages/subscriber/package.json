{
  "name": "@bemedev/subscriber",
  "version": "0.2.0",
  "description": "Subscriber package, a recursive subscription manager.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "files": [
    "lib",
    "./LICENSE",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/node-subscriber/tree/main/packages/subscriber"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "subscriber",
    "subscribe",
    "rescursive",
    "manager",
    "subscription"
  ],
  "scripts": {
    "build": "pnpm run rm:lib && pnpm run rolldown",
    "rm:lib": "pnpx rimraf ./lib",
    "fmt": "oxfmt",
    "pretest": "pnpm run build && pnpm run size",
    "lint": "oxlint --fix && pnpm run fmt",
    "_ci": "pnpm run lint && pnpm run pretest",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.1.1",
    "rolldown": "^1.2.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "size-limit": [
    {
      "path": "lib/**/*.js",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.d.ts",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.cjs",
      "limit": "10 kb"
    }
  ]
}
